# Copy to .env and fill in POSTGRES_PASSWORD. Never commit .env.
#
# Compose places these values inside a PostgreSQL URL, so keep the database
# name, user and password URL-safe. Generate a password with:
#   openssl rand -hex 24
POSTGRES_DB=polyfin
POSTGRES_USER=polyfin
POSTGRES_PASSWORD=
# Published on 127.0.0.1 only, for local database tools.
POSTGRES_PORT=5432

# Image tag without the leading v, e.g. 0.1.0. latest follows stable releases.
# To build the image from source instead:
#   docker compose -f compose.yaml -f compose.build.yaml up --build
POLYFIN_VERSION=latest

# Polyfin listens on the Jellyfin default port. 0.0.0.0 lets TVs and phones on
# your LAN connect; use 127.0.0.1 to keep it on this machine only.
# Do not forward this unencrypted HTTP port to the internet.
POLYFIN_BIND_IP=0.0.0.0
POLYFIN_PORT=8096

# debug, info, warn or error.
POLYFIN_LOG_LEVEL=info

# Disk space for parts of the files being read, e.g. 10GB or 512MiB.
POLYFIN_CACHE_SIZE=10GB

# GPU video is converted on: auto (the first that works), nvenc, vaapi or
# none. Give the container the GPU too: see compose.yaml.
POLYFIN_HWACCEL=auto
