# Copy to .env and set POSTGRES_PASSWORD. Never commit .env.
#
# Compose places the password inside a PostgreSQL URL, so keep it URL-safe.
# Generate one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional, advised: encrypts the secrets Polyfin stores in the database
# (API keys, client secrets, tokens and passwords). 32 random bytes in
# base64, made with `openssl rand -base64 32`, or 64 hexadecimal digits.
# Unset keeps them unencrypted, and System › Health warns about it; a
# malformed key stops Polyfin from starting. Keep it with your backups:
# without it, they have to be entered again.
# POLYFIN_SECRET_KEY=

# Only with the optional rclone service (see docs/installation.md): the
# password of rclone's remote control, given to rclone with the user
# polyfin. The rclone source in Polyfin signs in with both.
# RCLONE_RC_PASSWORD=
